{
  "info": {
    "_postman_id": "b6f2a1a0-8f2e-4a7f-9a3b-9b7c4a2f1e10",
    "name": "spring-boot-app: User Management & Role Permissions",
    "description": "End-to-end tests for auth (register/login/refresh/logout), self-service, and SYSADMIN-only user/role management. Run the whole collection top-to-bottom with the Collection Runner — each request feeds tokens/IDs into the next via collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "sysadminEmail", "value": "aysombath@gmail.com", "type": "string" },
    { "key": "sysadminPassword", "value": "@Sombath@1999", "type": "string" },
    { "key": "sysadminAccessToken", "value": "", "type": "string" },
    { "key": "sysadminRefreshToken", "value": "", "type": "string" },
    { "key": "userAccessToken", "value": "", "type": "string" },
    { "key": "userRefreshToken", "value": "", "type": "string" },
    { "key": "testUserEmail", "value": "", "type": "string" },
    { "key": "testUserId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Welcome (no auth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/welcome", "host": ["{{baseUrl}}"], "path": ["api", "welcome"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Sysadmin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{sysadminEmail}}\",\n  \"password\": \"{{sysadminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Response has accessToken and refreshToken', function () {",
                  "    pm.expect(json.accessToken).to.be.a('string');",
                  "    pm.expect(json.refreshToken).to.be.a('string');",
                  "});",
                  "pm.test('Roles include SYSADMIN', function () {",
                  "    pm.expect(json.roles).to.include('SYSADMIN');",
                  "});",
                  "pm.collectionVariables.set('sysadminAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('sysadminRefreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - New Test User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"fullName\": \"{{$randomFullName}}\",\n  \"password\": \"Password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Role defaults to USER', function () {",
                  "    pm.expect(json.roles).to.eql(['USER']);",
                  "});",
                  "pm.collectionVariables.set('userAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('userRefreshToken', json.refreshToken);",
                  "pm.collectionVariables.set('testUserEmail', json.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Duplicate Email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"fullName\": \"Duplicate\",\n  \"password\": \"Password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Returns a rotated refreshToken', function () {",
                  "    pm.expect(json.accessToken).to.be.a('string');",
                  "    pm.expect(json.refreshToken).to.not.equal(pm.collectionVariables.get('userRefreshToken'));",
                  "});",
                  "pm.collectionVariables.set('userAccessToken', json.accessToken);",
                  "pm.collectionVariables.set('userRefreshToken', json.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token - Reused Old Token (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"00000000-0000-0000-0000-000000000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401 for unknown/invalid refresh token', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{userRefreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204 No Content', function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User (Self-Service)",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userAccessToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('testUserId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Menu (as USER - restricted)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userAccessToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api", "menu"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Only sees Dashboard + Profile', function () {",
                  "    const keys = json.map(item => item.key);",
                  "    pm.expect(keys).to.eql(['dashboard', 'profile']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Access Admin Endpoint as USER (expect 403)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{userAccessToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "No Token (expect 403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 without a token', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin - User Management (SYSADMIN only)",
      "item": [
        {
          "name": "Get Menu (as SYSADMIN - full)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sysadminAccessToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api", "menu"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Sees all 6 menu items', function () { pm.expect(json.length).to.eql(6); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sysadminAccessToken}}", "type": "string" }] },
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Includes the 3 seeded sysadmins', function () {",
                  "    const emails = pm.response.json().map(u => u.email);",
                  "    ['aysombath@gmail.com', 'henrique.santana127@altmail.kr', 'rith.magnificent.9@gmail.com']",
                  "        .forEach(e => pm.expect(emails).to.include(e));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sysadminAccessToken}}", "type": "string" }] },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{testUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Email matches the registered test user', function () {",
                  "    pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('testUserEmail'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Roles (grant SYSADMIN)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sysadminAccessToken}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\"USER\", \"SYSADMIN\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{testUserId}}/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{testUserId}}", "roles"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Roles now include SYSADMIN', function () {",
                  "    pm.expect(pm.response.json().roles).to.include('SYSADMIN');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sysadminAccessToken}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{testUserId}}/enabled",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{testUserId}}", "enabled"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('enabled is false', function () { pm.expect(pm.response.json().enabled).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Enable User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sysadminAccessToken}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{testUserId}}/enabled",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{testUserId}}", "enabled"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('enabled is true', function () { pm.expect(pm.response.json().enabled).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Test User (cleanup)",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sysadminAccessToken}}", "type": "string" }] },
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{{testUserId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
